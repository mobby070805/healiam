# Copy to .env.local and fill in. Every value here is optional:
# the site builds and runs without any of them.

# Google Analytics measurement ID. Left empty, no analytics script is loaded.
NEXT_PUBLIC_GA_ID=

# Where the /contact message form posts (Formspree, Basin, your own handler).
# Left empty, /contact shows an "email us" panel instead of a form that
# cannot deliver.
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=

# Google Maps browser key for the fair venue photos (Google Street View Static API),
# the same images healiam.com/fairs shows. Restrict it in Google Cloud to the site's
# domains (healiam.com, the Netlify preview) and to the Street View Static API.
# Left empty, venue photos show a map-pin tile instead.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
