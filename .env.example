# Copy to .env.local and fill in. Every value here is optional:
# the site builds and runs without any of them.

# Google Analytics measurement ID. Left empty, no analytics script is loaded.
NEXT_PUBLIC_GA_ID=

# Where the /contact message form posts (Formspree, Basin, your own handler).
# Left empty, /contact shows an "email us" panel instead of a form that
# cannot deliver.
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=
